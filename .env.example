# Get these from developer.paypal.com (Sandbox > Apps & Credentials)
PAYPAL_CLIENT_ID=your_sandbox_client_id

# Optional but recommended: lets the concierge use a real OpenAI model.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Use 3000 locally; most hosts provide PORT automatically.
PORT=3000

